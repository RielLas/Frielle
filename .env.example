# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
COMMAND_PREFIX=r!

# Optional: MongoDB Atlas Cluster URI (Shared with Ciel cluster)
# If left empty, Raziel automatically falls back to local persistent JSON memory.
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?appName=YourCluster

# AI Engine: Gemini Free-Tier High RPD Architecture
# Single key or comma-separated list of keys for automatic rate-limit cycling
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key1,key2,key3

# Models
DEFAULT_MODEL=gemini-3.5-flash-lite
